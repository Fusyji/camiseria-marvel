# .env.example
# Marvel Sastrería - Environment Variables Configuration

# Resend API Key for serverless transactional emails
RESEND_API_KEY=

# Atelier recipient email for orders and notifications
ATELIER_NOTIFICATION_EMAIL=

# Sender email address configured in Resend (e.g., Marvel Sastrería <atelier@marvelsastreria.com> or onboarding@resend.dev)
EMAIL_FROM=
