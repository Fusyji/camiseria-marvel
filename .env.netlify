# ==============================================================================
# MARVEL SASTRERÍA (MR) — Variables de Entorno para Netlify
# ==============================================================================
# Instrucciones de importación en Netlify:
# 1. Ve a tu panel de Netlify: Site configuration > Environment variables
# 2. Haz clic en "Add a variable" y selecciona "Import from a .env file"
# 3. Pega este contenido o sube este archivo.
# ==============================================================================

# 1. Clave de API de Resend (Generar gratis en https://resend.com/api-keys)
# Reemplaza 're_tu_api_key_aqui' con tu clave real al crear la cuenta en Resend
RESEND_API_KEY=re_tu_api_key_aqui

# 2. Buzón del Atelier para notificaciones y copia de pedidos
ATELIER_NOTIFICATION_EMAIL=dygondock@gmail.com

# 3. Remitente oficial (Para pruebas puedes usar el dominio sandbox de Resend: 'onboarding@resend.dev',
# luego se cambia a tu dominio verificado: 'Marvel Sastrería <pedidos@marvelsastreria.com>')
EMAIL_FROM=Marvel Sastrería <onboarding@resend.dev>
